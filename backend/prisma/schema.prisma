// ============================================================================
//  跨行債權申報與彙整平台 — 資料庫 Schema（v0.3，2026-07-28 流程改版）
//  設計要點（詳見 docs/案件流程設計_債權申報與彙整.md）：
//   - 只做「跨行債權資訊傳遞與彙整」：申報 → 全員確認 → 一次揭露、產出債權彙整表
//     → 主辦線下與債務人確認後回報成立/不成立。無還款計劃、無時限控管。
//   - 各行「自填自己的」債權明細（非主辦代填）；主辦亦自填、自我確認並可修改。
//   - 封閉式申報：申報期各行只見自己；全員確認後「一次揭露」（防錨定）。
//   - 揭露後有疑義 → 任一參與行標記 → 全員重新確認（迴圈，round 遞增）。
//   - 結案（成立/不成立）為終態、完全鎖死；(courtCode, docNumber) 唯一，不得同文號新建。
//   - 不儲存債務人個資；債務人／法院全程線下。
//  金額 Decimal(21,4)。
// ============================================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================== 列舉 ==============================

enum BankType {
  BANK
  PLATFORM
}

enum Role {
  ADMIN // 平台管理員（開發商）：只見案件狀態／進度，不見任何數字
  BANK_STAFF // 銀行人員（主辦/其他債權行因案動態認定）
  PLATFORM_AUDITOR // 平台稽核（唯讀，可見全部含各行明細）
}

enum AccountStatus {
  PENDING_ACTIVATION // 正式區：已建立、待以啟用碼首次登入並設定密碼
  ACTIVE // 已啟用
  SUSPENDED // 已停用（管理員）
}

enum AccessCodePurpose {
  ACTIVATION // 帳號啟用碼（正式區首次登入用）
  PASSWORD_RESET // 密碼重置碼（管理員核發）
}

enum ResetRequestStatus {
  PENDING // 待管理員處理
  RESOLVED // 已核發重置碼
}

// 案件狀態機：DRAFT → PENDING_CONFIRMATION → PENDING_OUTCOME → ESTABLISHED / NOT_ESTABLISHED
enum CaseStatus {
  DRAFT // 主辦起案＋邀請（依法院公文），尚未發布
  PENDING_CONFIRMATION // 已發布：各行封閉申報並確認自己（含主辦）
  PENDING_OUTCOME // 全員確認→一次揭露、已產出債權彙整表，待主辦回報結果
  ESTABLISHED // 主辦線下與債務人確認後回報「成立」（終態、鎖死）
  NOT_ESTABLISHED // 主辦回報「不成立」（終態、鎖死）
}

enum ParticipantConfirmationStatus {
  PENDING // 待該行自填並確認
  CONFIRMED // 該行已確認自己的數字
}

// 參與行被移出的方式（保留紀錄供稽核；可被主辦重新邀請而復原）
enum ParticipantRemovalKind {
  REJECTED_SELF // 該行自行拒絕參與（自行生效即移出）
  REMOVED_BY_MAIN // 主辦移出（誤加／非債權人）
}

enum CaseBankRole {
  MAIN
  CO_BANK
}

enum ClaimType {
  CREDIT_LOAN
  CREDIT_CARD
  GUARANTEE
  OTHER
}

enum NotificationType {
  CASE_INVITATION // 被邀請參與案件
  CASE_PUBLISHED // 案件發布，開放封閉申報
  PARTICIPANT_CONFIRMED // 某行已完成確認（通知主辦）
  ALL_CONFIRMED_DISCLOSED // 全員確認、已揭露並產出彙整表
  DOUBT_RAISED // 有人標記疑義
  REOPENED_FOR_DOUBT // 因疑義退回，請重新確認
  PARTICIPATION_REJECTED // 某行拒絕參與（通知主辦）
  PARTICIPANT_REMOVED // 被主辦移出
  CASE_ESTABLISHED // 案件回報成立
  CASE_NOT_ESTABLISHED // 案件回報不成立
}

enum AuditActionType {
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  ACCOUNT_CREATED
  ACCOUNT_ACTIVATED
  ACCOUNT_SUSPENDED
  ACCOUNT_REACTIVATED
  ACCOUNT_LOCKED
  ACCOUNT_UNLOCKED
  CONSENT_GIVEN
  PASSWORD_CHANGED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_ISSUED
  // ---- 案件流程（v0.3）----
  CASE_CREATED
  CASE_UPDATED
  PARTICIPANT_INVITED
  PARTICIPANT_REMOVED
  PARTICIPATION_REJECTED
  CASE_PUBLISHED
  DECLARATION_SUBMITTED // 某行填/改自己的明細
  CASE_CONFIRMED // 某行確認自己
  CONFIRMATION_WITHDRAWN // 某行撤回自己的確認
  CASE_DISCLOSED // 全員確認→一次揭露
  DOUBT_RAISED // 標記疑義→退回全員重新確認
  CASE_ESTABLISHED
  CASE_NOT_ESTABLISHED
  BANK_ACTIVATED
  BANK_DEACTIVATED
  COURT_ACTIVATED
  COURT_DEACTIVATED
}

// ============================== 參考主檔 ==============================

/// 金融機構主檔（含完整代碼清單；isActive 控制可用範圍，後台可管理）
model Bank {
  bankCode String   @id // 3 碼金融機構代號（自然鍵）
  bankName String
  type     BankType @default(BANK)
  isActive Boolean  @default(false) // 僅啟用者可選/可登入

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  casesAsMain   Case[]                @relation("CaseMainBank")
  participantOf CaseParticipantBank[]

  @@index([isActive])
  @@map("banks")
}

/// 法院主檔（含完整清單；isActive 控制可用範圍，後台可管理）
model Court {
  courtCode String  @id // 法院代碼（自然鍵）
  courtName String
  courtType String? // 例：地方法院／高等法院…（選填）
  isActive  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cases Case[]

  @@index([isActive])
  @@map("courts")
}

// ============================== 使用者與帳號 ==============================

/// 使用者（承辦人員）；帳號＝email，單一所屬 bankCode，角色必填
model User {
  userId       String  @id @default(cuid())
  email        String  @unique
  name         String
  department   String?
  title        String?
  passwordHash String? // 待啟用時為 null，首次以啟用碼登入後設定

  bankCode      String
  role          Role
  accountStatus AccountStatus @default(PENDING_ACTIVATION)

  activatedAt DateTime?
  lastLoginAt DateTime?

  // 個資蒐集/利用同意（啟用時強制勾選）
  consentedAt    DateTime?
  consentVersion String?

  // 登入鎖定
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bank Bank @relation(fields: [bankCode], references: [bankCode])

  accessCodes              AccessCode[]           @relation("AccessCodeUser")
  createdAccessCodes       AccessCode[]           @relation("AccessCodeCreatedBy")
  passwordResetRequests    PasswordResetRequest[]
  createdCases             Case[]                 @relation("CaseCreatedBy")
  reportedOutcomes         Case[]                 @relation("CaseOutcomeReportedBy")
  participantConfirmations CaseParticipantBank[]  @relation("ParticipantConfirmedBy")
  raisedDoubts             CaseDoubt[]            @relation("DoubtRaisedBy")
  notifications            Notification[]
  auditLogs                AuditLog[]

  @@index([bankCode])
  @@index([accountStatus])
  @@map("users")
}

/// 一次性代碼（啟用碼／密碼重置碼）；僅存雜湊，明碼由外部管道遞送
model AccessCode {
  codeId    String            @id @default(cuid())
  userId    String
  purpose   AccessCodePurpose
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdBy String // 核發的管理員
  createdAt DateTime          @default(now())

  user    User @relation("AccessCodeUser", fields: [userId], references: [userId], onDelete: Cascade)
  creator User @relation("AccessCodeCreatedBy", fields: [createdBy], references: [userId])

  @@index([userId, purpose])
  @@map("access_codes")
}

/// 使用者申請密碼重置的佇列（供管理員檢視並核發重置碼）
model PasswordResetRequest {
  requestId  String             @id @default(cuid())
  userId     String
  status     ResetRequestStatus @default(PENDING)
  createdAt  DateTime           @default(now())
  resolvedAt DateTime?
  resolvedBy String?

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([status])
  @@map("password_reset_requests")
}

// ============================== 案件 ==============================

/// 案件；以 (courtCode, docNumber) 唯一辨識，不存債務人個資
model Case {
  caseId    String @id @default(cuid())
  courtCode String // 法院
  docNumber String // 法院公文文號（格式後續確認；僅作辨識，不解析）

  mainBankCode String // 最大債權行（主辦）；名單來源＝法院公文，系統不驗證完整性
  receiptDate  DateTime? // 收到公文日（informational）
  status       CaseStatus @default(DRAFT)

  // 揭露／輪次（每次因疑義退回重新揭露 round+1）
  round      Int       @default(1)
  disclosedAt DateTime? // 最近一次全員確認揭露的時間

  // 揭露時凍結的全案債權總額快照（各行 confirmedClaimAmount 加總）
  consolidatedTotal Decimal?  @db.Decimal(21, 4)

  // 結果回報（終態）
  outcomeReportedAt   DateTime?
  outcomeReportedBy   String?
  notEstablishedReason String? // 不成立時的理由（成立則為 null）

  createdBy String
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  court        Court @relation(fields: [courtCode], references: [courtCode])
  mainBank     Bank  @relation("CaseMainBank", fields: [mainBankCode], references: [bankCode])
  creator      User  @relation("CaseCreatedBy", fields: [createdBy], references: [userId])
  outcomeReporter User? @relation("CaseOutcomeReportedBy", fields: [outcomeReportedBy], references: [userId])

  participants CaseParticipantBank[]
  doubts       CaseDoubt[]
  snapshots    DeclarationSnapshot[]

  @@unique([courtCode, docNumber]) // 唯一業務鍵；結案後不得以同文號新建
  @@index([status])
  @@index([mainBankCode])
  @@map("cases")
}

/// 案件參與銀行（債權容器）；每行自填自己的明細並自我確認
model CaseParticipantBank {
  participantId String       @id @default(cuid())
  caseId        String
  bankCode      String
  roleInCase    CaseBankRole
  invitedAt     DateTime     @default(now())

  // 確認（含主辦）
  confirmationStatus ParticipantConfirmationStatus @default(PENDING)
  confirmedBy        String?
  confirmedAt        DateTime?

  // 確認當下凍結的該行債權總額快照
  confirmedClaimAmount Decimal? @db.Decimal(21, 4)

  // 移出／拒絕（保留紀錄；被主辦重新邀請時清空即復原）
  removedAt     DateTime?
  removalKind   ParticipantRemovalKind?
  removalReason String?

  case      Case  @relation(fields: [caseId], references: [caseId], onDelete: Cascade)
  bank      Bank  @relation(fields: [bankCode], references: [bankCode])
  confirmer User? @relation("ParticipantConfirmedBy", fields: [confirmedBy], references: [userId])

  items CreditItem[]

  @@unique([caseId, bankCode])
  @@index([bankCode])
  @@index([confirmationStatus])
  @@map("case_participant_banks")
}

/// 債權明細（掛在參與行下）；不存加總欄位，externalTotal 由四分項即時計算
model CreditItem {
  itemId        String    @id @default(cuid())
  participantId String
  claimType     ClaimType
  principal     Decimal   @default(0) @db.Decimal(21, 4) // 本金
  interest      Decimal   @default(0) @db.Decimal(21, 4) // 利息
  penalty       Decimal   @default(0) @db.Decimal(21, 4) // 違約金
  otherFee      Decimal   @default(0) @db.Decimal(21, 4) // 其他費用
  // externalTotal = principal+interest+penalty+otherFee（讀取即算，不落地）
  note          String?

  participant CaseParticipantBank @relation(fields: [participantId], references: [participantId], onDelete: Cascade)

  @@index([participantId])
  @@map("credit_items")
}

// ============================== 疑義與版本化 ==============================

/// 揭露後的疑義標記（append-only）；標記→退回 PENDING_CONFIRMATION 全員重新確認
model CaseDoubt {
  doubtId          String   @id @default(cuid())
  caseId           String
  round            Int // 標記時的案件輪次
  raisedByBankCode String // 標記者所屬銀行
  raisedByUserId   String?
  reason           String // 理由必填
  pointerBankCode  String? // 指向某行（選填）
  createdAt        DateTime @default(now())

  case     Case  @relation(fields: [caseId], references: [caseId], onDelete: Cascade)
  raisedBy User? @relation("DoubtRaisedBy", fields: [raisedByUserId], references: [userId])

  @@index([caseId])
  @@map("case_doubts")
}

/// 每一輪揭露時，各參與行申報內容的快照（版本化；供稽核與回溯）
model DeclarationSnapshot {
  snapshotId String   @id @default(cuid())
  caseId     String
  round      Int
  bankCode   String
  roleInCase CaseBankRole
  itemsJson  String // 該行當輪明細的 JSON 快照
  claimTotal Decimal  @db.Decimal(21, 4)
  confirmedAt DateTime?
  capturedAt DateTime @default(now())

  case Case @relation(fields: [caseId], references: [caseId], onDelete: Cascade)

  @@index([caseId, round])
  @@map("declaration_snapshots")
}

// ============================== 通知與稽核 ==============================

model Notification {
  notificationId String           @id @default(cuid())
  userId         String
  type           NotificationType
  relatedCaseId  String?
  message        String
  isRead         Boolean          @default(false)
  createdAt      DateTime         @default(now())

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

/// 單一稽核表（append-only，含帳號/案件狀態變更所需的 from/to 結構欄位）
model AuditLog {
  logId      String          @id @default(cuid())
  userId     String?
  bankCode   String?
  actionType AuditActionType
  targetType String? // 例：CASE / USER / BANK / COURT
  targetId   String?
  fromStatus String?
  toStatus   String?
  detail     String? // 補充（可存 JSON 文字）
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime        @default(now())

  user User? @relation(fields: [userId], references: [userId])

  @@index([createdAt])
  @@index([userId])
  @@index([actionType])
  @@map("audit_logs")
}
